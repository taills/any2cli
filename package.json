{
  "name": "any2cli",
  "version": "0.1.0",
  "description": "Turn any MCP server (stdio/SSE/HTTP) or OpenAPI spec into an agent-friendly CLI, with built-in OAuth2 browser login.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taills/anycli.git"
  },
  "homepage": "https://github.com/taills/anycli#readme",
  "bugs": {
    "url": "https://github.com/taills/anycli/issues"
  },
  "type": "module",
  "bin": {
    "any2cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm coverage && pnpm build",
    "prepublishOnly": "pnpm check",
    "prepack": "pnpm build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "cli",
    "llm",
    "agent",
    "oauth2"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.21.0",
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^15.0.0",
    "open": "^11.0.4",
    "swagger2openapi": "^7.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/swagger2openapi": "^7.0.4",
    "@vitest/coverage-v8": "^5.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
